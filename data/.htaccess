# The data/ folder lives inside the web root next to index.php.
# This file blocks direct web access to the CSV files that power the
# site's forms and the admin dashboard, so visitors can never fetch
# data/subscribers.csv (or friends) via a URL.
#
# Apache 2.4+:
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 fallback:
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>